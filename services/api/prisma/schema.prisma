generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  phone              String?             @unique
  passwordHash       String?
  emailVerified      Boolean             @default(false)
  emailVerifiedAt    DateTime?
  image              String?
  addresses          Address[]
  orders             Order[]
  checkoutSessions   CheckoutSession[]
  wishlistItems      Wishlist[]
  reviews            Review[]
  prizeVouchers      PrizeVoucher[]
  voucherRedemptions VoucherRedemption[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model EmailVerification {
  id        String    @id @default(cuid())
  email     String    @unique
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // Nullable so existing rows survive the migration. Login rejects an admin
  // without a hash: set one with `npm run admin:set-password`.
  passwordHash String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  admins      AdminUser[]
}

model Permission {
  id     String @id @default(cuid())
  action String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  priority  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Theme {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  description      String?
  story            String?
  imageUrl         String?
  bannerImageUrl   String?
  featureImageUrl  String?
  homepageFeatured Boolean         @default(false)
  primaryColor     String          @default("#111827")
  secondaryColor   String          @default("#ff6b5b")
  accentColor      String          @default("#4ecdc4")
  fontFamily       String          @default("Inter, Arial, sans-serif")
  animationStyle   String          @default("fade")
  /// Short clip played on the homepage hero while this theme's slide is showing.
  /// Starts muted behind a speaker button — browsers block audio that starts on
  /// its own, and an unannounced song is a reason to close the tab.
  songUrl          String?
  /// Shown beside the speaker button so the track is credited.
  songTitle        String?
  priority         Int             @default(0)
  active           Boolean         @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  products         Product[]
  announcements    Announcement[]
  hampers          ProductHamper[]
}

model Collection {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  priority  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  sku             String           @unique
  description     String
  tags            String[]
  brand           String           @default("Fly Free")
  material        String?
  washCare        String?
  price           Int
  mrp             Int
  discountPercent Int              @default(0)
  gstPercent      Int              @default(5)
  weightGrams     Int?
  videoUrl        String?
  view360Url      String?
  seoTitle        String?
  seoDescription  String?
  isVisible       Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  isTrending      Boolean          @default(false)
  isNewArrival    Boolean          @default(false)
  categoryId      String
  collectionId    String?
  themeId         String?
  category        Category         @relation(fields: [categoryId], references: [id])
  collection      Collection?      @relation(fields: [collectionId], references: [id])
  theme           Theme?           @relation(fields: [themeId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  hampers         ProductHamper[]
  reviews         Review[]
  orderItems      OrderItem[]
  wishlistItems   Wishlist[]
  influencers     Influencer[]     @relation("InfluencerProducts")
  instagramPosts  InstagramPost[]  @relation("InstagramPostProducts")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  color     String?
  url       String
  alt       String?
  priority  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id        String     @id @default(cuid())
  productId String
  sku       String     @unique
  color     String
  size      String
  price     Int?
  product   Product    @relation(fields: [productId], references: [id])
  inventory Inventory?
}

model ProductHamper {
  id          String   @id @default(cuid())
  productId   String?
  themeId     String?
  name        String
  description String?
  contents    String[] @default([])
  imageUrl    String?
  images      String[] @default([])
  sizeNote    String?
  price       Int
  gstPercent  Int      @default(5)
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  theme       Theme?   @relation(fields: [themeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([themeId])
  @@index([isActive])
}

model Inventory {
  id            String         @id @default(cuid())
  variantId     String         @unique
  stock         Int            @default(0)
  lowStockAlert Int            @default(5)
  warehouse     String?
  barcode       String?
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  updatedAt     DateTime       @updatedAt
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("India")
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  guestId   String?
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  productId String
  user      User?    @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Order {
  id                  String               @id @default(cuid())
  /// Human-facing reference, e.g. FF-2026-000123. Generated at checkout.
  orderNumber         String?              @unique
  userId              String
  shippingName        String?
  shippingPhone       String?
  shippingLine1       String?
  shippingLine2       String?
  shippingCity        String?
  shippingState       String?
  shippingPostalCode  String?
  shippingCountry     String               @default("India")
  status              OrderStatus          @default(PLACED)
  subtotal            Int
  discount            Int                  @default(0)
  shippingFee         Int                  @default(0)
  tax                 Int                  @default(0)
  total               Int
  user                User                 @relation(fields: [userId], references: [id])
  items               OrderItem[]
  payment             Payment?
  referrals           Referral[]
  invoice             Invoice?
  statusHistory       OrderStatusHistory[]
  reviews             Review[]
  voucherRedemptions  VoucherRedemption[]
  reviewRequestSentAt DateTime?
  reviewSubmittedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  changedBy  String?
  order      Order        @relation(fields: [orderId], references: [id])
  createdAt  DateTime     @default(now())
}

model CheckoutSession {
  id              String    @id @default(cuid())
  userId          String
  razorpayOrderId String    @unique
  amount          Int
  quote           Json
  status          String    @default("OPEN")
  lastError       String?
  paymentId       String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([paymentId])
}

model Invoice {
  id            String    @id @default(cuid())
  orderId       String    @unique
  invoiceNumber String    @unique
  status        String    @default("GENERATED")
  sentAt        DateTime?
  metadata      Json?
  order         Order     @relation(fields: [orderId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String
  name      String
  sku       String
  price     Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountAmount  Int?
  discountPercent Int?
  minOrderAmount  Int?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  isFirstOrder    Boolean   @default(false)
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String        @default("RAZORPAY")
  /// Unique so a replayed or double-submitted gateway callback cannot turn one
  /// payment into two orders — the second insert loses on this constraint.
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Int
  rawPayload        Json?
  paidAt            DateTime?
  order             Order         @relation(fields: [orderId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
}

model Review {
  id           String       @id @default(cuid())
  userId       String
  productId    String
  orderId      String?
  rating       Int
  title        String?
  body         String
  mediaUrls    String[]
  helpfulVotes Int          @default(0)
  status       ReviewStatus @default(PENDING)
  user         User         @relation(fields: [userId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  createdAt    DateTime     @default(now())
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  message   String
  href      String?
  imageUrl  String?
  ctaLabel  String?
  type      String    @default("INFO")
  priority  Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  themeId   String?
  theme     Theme?    @relation(fields: [themeId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  channel    String
  type       String?
  entityType String?
  entityId   String?
  title      String
  body       String
  status     String    @default("PENDING")
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  category  String   @default("Support")
  question  String
  answer    String
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([category])
  @@index([priority])
}

model Influencer {
  id                   String     @id @default(cuid())
  name                 String
  email                String     @unique
  code                 String     @unique
  linkKey              String?
  imageUrl             String?
  instagramUrl         String?
  facebookUrl          String?
  xUrl                 String?
  youtubeUrl           String?
  buyerDiscountPercent Int        @default(10)
  commissionRate       Float      @default(5.0)
  totalEarnings        Int        @default(0)
  totalReferrals       Int        @default(0)
  isActive             Boolean    @default(true)
  homepageFeatured     Boolean    @default(false)
  socialHandle         String?
  followers            Int?
  instagramFollowers   Int?
  facebookFollowers    Int?
  xFollowers           Int?
  youtubeFollowers     Int?
  displayOrder         Int        @default(0)
  products             Product[]  @relation("InfluencerProducts")
  referrals            Referral[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([isActive, displayOrder])
}

model Referral {
  id                   String     @id @default(cuid())
  influencerId         String
  orderId              String?
  code                 String     @unique
  buyerDiscountPercent Int        @default(0)
  commissionAmount     Int        @default(0)
  linkKey              String?
  convertedAt          DateTime?
  clicks               Int        @default(0)
  conversions          Int        @default(0)
  totalEarnings        Int        @default(0)
  influencer           Influencer @relation(fields: [influencerId], references: [id])
  order                Order?     @relation(fields: [orderId], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Return {
  id           String   @id @default(cuid())
  orderId      String
  reason       String
  description  String?
  status       String   @default("REQUESTED")
  refundAmount Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SizeGuide {
  id            String   @id @default(cuid())
  fitType       String   @unique @default("regular") // regular, oversized, polo
  chartImageUrl String?
  note          String?
  priority      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fitType])
  @@index([active])
}

model InstagramPost {
  id            String    @id @default(cuid())
  imageUrl      String?
  videoUrl      String?
  caption       String
  instagramLink String
  displayOrder  Int       @default(0)
  products      Product[] @relation("InstagramPostProducts")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([displayOrder])
}

/// Every API request outcome, so admins can see live and historical activity
/// without shelling into the server. Written asynchronously off the response path.
model ActivityLog {
  id         String   @id @default(cuid())
  level      String // INFO | WARN | ERROR
  method     String
  path       String
  statusCode Int
  durationMs Int
  userId     String?
  userEmail  String?
  ip         String?
  userAgent  String?
  message    String?
  /// Stack trace or error payload, only populated for failures.
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([statusCode])
  @@index([userId])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  name          String
  sessionId     String?
  userId        String?
  productId     String?
  productSlug   String?
  orderId       String?
  state         String?
  pincodePrefix String?
  device        String?
  referrer      String?
  path          String?
  metadata      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([name])
  @@index([createdAt])
  @@index([productId])
  @@index([userId])
  @@index([state])
  @@index([pincodePrefix])
}

/// A partner event Fly Free sponsors — the Dibrugarh Korean Club collaboration
/// is the first. The storefront banner runs from the moment this is created;
/// the winners and their vouchers arrive after the event.
///
/// Visibility mirrors Announcement (isActive + priority + a startsAt/endsAt
/// window) so the same "live right now" query serves both.
model Sponsorship {
  id             String         @id @default(cuid())
  partnerName    String
  /// Social handle as displayed, e.g. "@dibrugarhkorean.club".
  partnerHandle  String?
  partnerUrl     String?
  eventName      String
  eventDate      DateTime?
  location       String?
  /// Banner copy. Falls back to the partner and event names when blank.
  headline       String?
  blurb          String?
  bannerImageUrl String?
  partnerLogoUrl String?
  isActive       Boolean        @default(false)
  priority       Int            @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  /// Winners stay hidden until the event concludes and this is switched on.
  /// Even then only name and position are published — never phone or code.
  showWinners    Boolean        @default(false)
  /// When the winners list stops being published, while the banner itself stays.
  /// Set on reveal so an old result retires by itself instead of sitting on the
  /// homepage for years waiting for someone to remember to switch it off.
  winnersUntil   DateTime?
  vouchers       PrizeVoucher[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// Serves the storefront's "live right now" lookup: the isActive equality
  /// first, then the date window, then the sort. Nothing here is ever deleted,
  /// so this query must stay index-only as the table grows.
  @@index([isActive, startsAt, endsAt, priority])
  @@index([isActive, priority])
}

/// A prize voucher handed to one event winner: store credit with a rupee
/// balance, spendable over `maxRedemptions` orders until it runs out.
///
/// Amounts are WHOLE RUPEES, matching Order.total and every other figure
/// downstream of priceCheckout. The catalog stores paise; this does not.
model PrizeVoucher {
  id              String              @id @default(cuid())
  sponsorshipId   String
  /// Secret. Shared with the winner privately and never served by a public
  /// endpoint — the storefront banner selects columns explicitly to keep it out.
  code            String              @unique
  winnerName      String
  winnerPhone     String?
  /// 1 = first place. Orders the published winners list.
  position        Int?
  /// Rupees the voucher was issued for. Never changes; `balance` is what moves.
  value           Int
  balance         Int
  maxRedemptions  Int                 @default(2)
  redemptionsUsed Int                 @default(0)
  expiresAt       DateTime?
  isActive        Boolean             @default(true)
  /// Whether the code belongs to one person. On by default: a prize is awarded
  /// to a named winner. Turn it off for a code meant to be shared publicly, and
  /// `maxRedemptions` becomes a pool everyone draws from rather than one
  /// person's allowance.
  lockToFirstUser Boolean             @default(true)
  /// Winner's photo for the public card. Optional — the card falls back to
  /// their initial.
  winnerImageUrl  String?
  /// Recorded on first redemption whatever the lock setting, because knowing who
  /// spent first is useful either way. Only enforced when lockToFirstUser is on.
  claimedByUserId String?
  sponsorship     Sponsorship         @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  claimedBy       User?               @relation(fields: [claimedByUserId], references: [id])
  redemptions     VoucherRedemption[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([sponsorshipId])
  @@index([claimedByUserId])
}

/// Every movement of voucher credit, and the reason for it.
///
/// PrizeVoucher.balance/redemptionsUsed are a denormalised running total for
/// fast reads; this table is the truth an admin can audit. A REDEEM row is
/// written inside the same transaction that creates the order, so a replayed
/// payment cannot spend the balance twice.
model VoucherRedemption {
  id           String       @id @default(cuid())
  voucherId    String
  /// Null only for an admin ADJUSTMENT, which belongs to no order.
  orderId      String?
  userId       String?
  /// Rupees moved. Positive on REDEEM, negative on REVERSAL.
  amount       Int
  balanceAfter Int
  /// REDEEM | REVERSAL | ADJUSTMENT
  kind         String       @default("REDEEM")
  note         String?
  voucher      PrizeVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id])
  /// The customer who spent the credit. Null on an admin adjustment.
  user         User?        @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())

  /// Makes a replayed webhook or a repeated cancellation a no-op rather than a
  /// second movement of the same credit.
  @@unique([voucherId, orderId, kind])
  @@index([voucherId])
  @@index([orderId])
}
