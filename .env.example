# ===== LOCAL DEVELOPMENT CONFIG =====
# Copy this to .env.local for local development

# Web & Admin Apps (point to local API)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# Production canonical domain used by SEO metadata, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://flyfree.co.in

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API Service (NestJS)
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://neondb_owner:

# JWT
JWT_SECRET=super-secret-jwt-key-at-least-32-characters-long-for-development-only-change-in-prod
JWT_EXPIRE=7d

# Email (Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-sender@example.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Keep blank/false locally so developers can inspect. Set true only when testing protection in dev.
NEXT_PUBLIC_ENABLE_CONTENT_PROTECTION=false

# Payment (Razorpay Test)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI
ANTHROPIC_API_KEY=sk-...
